# TMDB (required for movie/tv scraping)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Bangumi (optional, anonymous search works but with stricter rate limits)
BANGUMI_ACCESS_TOKEN=

# 115 cloud — two modes, pick one:
#
# Mode 1: Cookie (recommended, no approval needed)
# Run `115-media auth` to QR login, or paste cookies here:
CLOUD_115_COOKIES=
#
# Mode 2: OpenAPI (requires approval from open.115.com)
CLOUD_115_APP_ID=
CLOUD_115_APP_SECRET=
CLOUD_115_ACCESS_TOKEN=
CLOUD_115_REFRESH_TOKEN=
